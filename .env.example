# Copy to `.env` (cp .env.example .env). Every value has a working default.
BACKEND_PORT=8095
FRONTEND_PORT=8086
BASE_SERVER_URL=http://127.0.0.1:8095

# Google sign-in for the Vue frontend (leave blank to just boot the UI)
GOOGLE_CLIENT_ID=

# Gemini key enables AI topology scan / modify in ai-engine
GEMINI_API_KEY=

# GNS3 server credentials, if your GNS3 server requires auth
GNS3_USERNAME=
GNS3_PASSWORD=
